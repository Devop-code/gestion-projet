// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  student
  supervisor
}

enum ProjectType {
  group_project
  internship_report
}

enum TaskStatus {
  pending
  in_progress
  completed
}

model Profile {
  id         String   @id @default(uuid())
  email      String   @unique
  first_name String
  last_name  String
  role       Role
  password   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  // Relations
  projectsCreated Project[] @relation("CreatedProjects")
  projectsSupervised Project[] @relation("SupervisedProjects")
  projectMemberships ProjectMember[]
  tasksCreated Task[] @relation("CreatedTasks")
  tasksAssigned Task[] @relation("AssignedTasks")
  sessionReports SessionReport[] @relation("SessionReportAuthor")
  notes Note[] @relation("NoteAuthor")
  taskListsCreated TaskList[] @relation("TaskListCreator")
  sessionReportsValidated SessionReport[] @relation("SessionReportValidator")
}

model Project {
  id           String         @id @default(uuid())
  title        String
  description  String?
  type         ProjectType
  created_by   String
  supervisor_id String?
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  // Relations
  creator      Profile        @relation("CreatedProjects", fields: [created_by], references: [id])
  supervisor   Profile?       @relation("SupervisedProjects", fields: [supervisor_id], references: [id])
  members      ProjectMember[]
  taskLists    TaskList[]
  sessionReports SessionReport[]
  notes        Note[]
}

model ProjectMember {
  id         String   @id @default(uuid())
  project_id String
  student_id String
  joined_at  DateTime @default(now())
  // Relations
  project    Project  @relation(fields: [project_id], references: [id])
  student    Profile  @relation(fields: [student_id], references: [id])
}

model TaskList {
  id          String   @id @default(uuid())
  project_id  String
  title       String
  description String?
  created_by  String
  is_completed Boolean @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  // Relations
  project     Project  @relation(fields: [project_id], references: [id])
  creator     Profile  @relation("TaskListCreator", fields: [created_by], references: [id])
  tasks       Task[]
}

model Task {
  id           String   @id @default(uuid())
  task_list_id String
  title        String
  description  String?
  status       TaskStatus
  assigned_to  String?
  created_by   String
  completed_at DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  // Relations
  taskList     TaskList @relation(fields: [task_list_id], references: [id])
  creator      Profile  @relation("CreatedTasks", fields: [created_by], references: [id])
  assignee     Profile? @relation("AssignedTasks", fields: [assigned_to], references: [id])
}

model SessionReport {
  id           String   @id @default(uuid())
  project_id   String
  author_id    String
  title        String
  content      String
  session_date DateTime
  is_validated Boolean  @default(false)
  validated_by String?
  validated_at DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  // Relations
  project      Project  @relation(fields: [project_id], references: [id])
  author       Profile  @relation("SessionReportAuthor", fields: [author_id], references: [id])
  validator    Profile? @relation("SessionReportValidator", fields: [validated_by], references: [id])
}

model Note {
  id         String   @id @default(uuid())
  project_id String
  author_id  String
  title      String
  content    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  // Relations
  project    Project  @relation(fields: [project_id], references: [id])
  author     Profile  @relation("NoteAuthor", fields: [author_id], references: [id])
}
